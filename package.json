{
  "name": "revflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.12.0",
  "description": "AI-assisted revenue automation workbench for complex SaaS billing.",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "db:migrate": "npm run migrate -w @revflow/db",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\""
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.2",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
