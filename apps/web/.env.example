# Web-project subset. Copy to apps/web/.env.local only when running Next.js independently.
# Never commit apps/web/.env.local.

# [PUBLIC] Values with NEXT_PUBLIC_ are included in browser bundles.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# [SECRET] Used only by Next.js server code. Configure it in Vercel for hosted deployments.
CLERK_SECRET_KEY=
