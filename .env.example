# RevFlow environment inventory
# Copy to .env for local development. Never place real credentials in this tracked file.
# [SECRET] values must be stored only in an ignored local env file or deployment secret manager.
# [PUBLIC] values may be exposed to the browser. All other values are non-secret configuration.

# Runtime
NODE_ENV=development
API_PORT=4000
# Informational today; the Next.js dev script currently binds port 3000 directly.
WEB_PORT=3000
# Vercel injects PORT automatically. Do not set it manually in Vercel.

# Database and queue
# [SECRET in hosted environments] Direct Postgres URL; used by migrations and local fallback.
DATABASE_URL=postgres://revflow:revflow@localhost:5432/revflow
# [SECRET] Neon pooled URL; preferred by API/serverless runtime traffic.
DATABASE_URL_POOLED=
# [SECRET] Optional direct aliases for migrations, dumps, and administrative operations.
DATABASE_URL_UNPOOLED=
DATABASE_MIGRATION_URL=
# [SECRET when credentials are embedded] Redis connection URL.
REDIS_URL=redis://localhost:6379

# Web/API routing
# [PUBLIC] Browser-visible API base URL.
NEXT_PUBLIC_API_URL=http://localhost:4000
# [PUBLIC] Optional label shown in the application shell, for example local, preview, or production.
NEXT_PUBLIC_APP_ENV=local
# Comma-separated browser origins allowed by the API in production.
WEB_ORIGIN=http://localhost:3000

# AI provider
AI_PROVIDER=gemini
# [SECRET] Server-side Gemini credential. Never prefix this variable with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=60000

# Authentication
# Local mode is development-only and uses migration 008 demo membership.
AUTH_MODE=local
LOCAL_AUTH_USER_ID=local-user
LOCAL_AUTH_ORGANIZATION_ID=local-org
LOCAL_AUTH_DISPLAY_NAME=Local Admin
# Clerk publishable keys are identifiers, not secrets. The API uses the unprefixed form.
CLERK_PUBLISHABLE_KEY=
# [PUBLIC] Browser-visible Clerk configuration.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# [SECRET] Required server-side by both API and Next.js when Clerk is enabled.
CLERK_SECRET_KEY=

# Safety and test controls
# Demo data is blocked in production unless this is explicitly enabled.
ALLOW_DEMO_SEED=false
# Enables database-dependent integration tests against the configured database.
RUN_DATABASE_TESTS=false
