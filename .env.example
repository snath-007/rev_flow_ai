NODE_ENV=development

DATABASE_URL=postgres://revflow:revflow@localhost:5432/revflow
# Optional Neon/serverless runtime URL. When present, the app prefers this pooled URL.
DATABASE_URL_POOLED=
# Direct aliases supported for production migrations.
DATABASE_URL_UNPOOLED=
DATABASE_MIGRATION_URL=
REDIS_URL=redis://localhost:6379

API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Comma-separated browser origins allowed by the API in production.
WEB_ORIGIN=http://localhost:3000

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=60000

# Authentication. Local mode is development-only and uses migration 008 demo membership.
AUTH_MODE=local
LOCAL_AUTH_USER_ID=local-user
LOCAL_AUTH_ORGANIZATION_ID=local-org
LOCAL_AUTH_DISPLAY_NAME=Local Admin

# Demo data is blocked in production unless this is explicitly enabled.
ALLOW_DEMO_SEED=false

# Required by the API when AUTH_MODE=clerk.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
